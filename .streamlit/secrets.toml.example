# ─────────────────────────────────────────────────────────────────────────────
# Blitz Ops Dashboard — secrets template
# ─────────────────────────────────────────────────────────────────────────────
# This file (.example) IS committed to git so the structure is documented.
# Your real .streamlit/secrets.toml is gitignored and must NEVER be committed.
#
# LOCAL SETUP:
#   1. Copy this file to .streamlit/secrets.toml
#   2. Replace the placeholder values with your real Azure AD credentials and
#      SharePoint file URLs.
#   3. Restart `streamlit run Home.py` — the dashboard will pull live from
#      SharePoint instead of the local data/ folder.
#
# PRODUCTION (STREAMLIT CLOUD):
#   1. Open your app on share.streamlit.io
#   2. Click ⋯ next to the app → Settings → Secrets
#   3. Paste this entire block (with real values) into the text editor
#   4. Save. Streamlit Cloud auto-redeploys with secrets injected.

# ─── Azure AD app credentials ────────────────────────────────────────────────
# From your "Blitz Operations Dashboard" app registration in Microsoft Entra:
#   Overview page → Directory (tenant) ID    → AZURE_TENANT_ID
#   Overview page → Application (client) ID  → AZURE_CLIENT_ID
#   Certificates & secrets → secret Value    → AZURE_CLIENT_SECRET
AZURE_TENANT_ID     = "00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID     = "00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET = "your-client-secret-value-here"

# ─── SharePoint file URLs ────────────────────────────────────────────────────
# Each key here maps to a `secrets_key` in Home.py's LOADERS list.
# Paste the full SharePoint URL of each file. Either browser URL or share
# link works — Microsoft Graph's /shares endpoint accepts both.
[files]
DELIVERY = "https://rideblitz.sharepoint.com/sites/Operations/Shared Documents/Ops Data Collection.xlsx"
MOBILE   = "https://rideblitz.sharepoint.com/sites/Operations/Shared Documents/Mobile Sellers Master.xlsx"

# When the new pages land (Borzo, EV Leasing), add additional file entries:
# BORZO_MONTHLY  = "https://rideblitz.sharepoint.com/.../Borzo Metrics 2022-Now.xlsx"
# BORZO_CLIENTS  = "https://rideblitz.sharepoint.com/.../Summary Penjualan 2025.xlsx"
